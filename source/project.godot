; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dawn of the Sprout"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

AssetLibrary="*res://autoload/asset_library.gd"
GameState="*res://autoload/game_state.gd"
ProgressState="*res://autoload/progress_state.gd"
AudioManager="*res://autoload/audio_manager.gd"
NarrativeManager="*res://autoload/narrative_manager.gd"
MapKnowledgeManager="*res://autoload/map_knowledge_manager.gd"
GuidanceDirector="*res://autoload/guidance_director.gd"
ItemEffectDirector="*res://autoload/item_effect_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

move_up={
"deadzone": 0.5,
"events": []
}
move_down={
"deadzone": 0.5,
"events": []
}
move_left={
"deadzone": 0.5,
"events": []
}
move_right={
"deadzone": 0.5,
"events": []
}
interact={
"deadzone": 0.5,
"events": []
}
charge={
"deadzone": 0.5,
"events": []
}
restart_run={
"deadzone": 0.5,
"events": []
}
pause={
"deadzone": 0.5,
"events": []
}
inventory={
"deadzone": 0.5,
"events": []
}
world_map={
"deadzone": 0.5,
"events": []
}
skip_text={
"deadzone": 0.5,
"events": []
}
sprint={
"deadzone": 0.5,
"events": []
}
debug_toggle={
"deadzone": 0.5,
"events": []
}
key_hints_toggle={
"deadzone": 0.5,
"events": []
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.025, 1)
